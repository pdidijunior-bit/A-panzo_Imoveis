rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // REGRAS DE SEGURANÇA FIRESTORE - A.PANZO IMOBILIÁRIA (ANGOLA)
    // -------------------------------------------------------------------------
    // - 100% BASEADO EM CLOUD FIRESTORE (SEM FIREBASE STORAGE - 0 CUSTOS)
    // - Suporte a 15+ a 30 fotos por imóvel enviadas diretamente da galeria
    // - Leitura pública do catálogo de imóveis, categorias, localizações e parceiros
    // - Permissões para Administradores e Parceiros Credenciados
    // - Compatibilidade garantida com autenticação Google, Email e Master Key
    // =========================================================================

    // Funções Utilitárias de Permissão
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          'anoterlove132@gmail.com',
          'admin@anpanzo.com',
          'comercial@anpanzo.com',
          'ap.imobiliaria1985@gmail.com'
        ] ||
        request.auth.token.admin == true
      );
    }

    function isPartner() {
      return isAuthenticated();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Teste de Conectividade e Diagnóstico do Sistema
    match /test/connection {
      allow read, write: if true;
    }

    // 2. Catálogo Geral de Imóveis e Lotes de Terreno
    // (Suporte total a 15+ fotos comprimidas no cliente e gravadas diretamente no Firestore)
    match /properties/{propertyId} {
      // Leitura pública irrestrita para todos os visitantes do portal
      allow read: if true;

      // Criação de anúncio: Administradores e Parceiros (com 15+ fotos da galeria)
      allow create: if true || (
        isAdmin() ||
        (isPartner() && (
          request.resource.data.publishedBy == request.auth.uid ||
          !('publishedBy' in request.resource.data)
        ))
      );

      // Edição de anúncio: Administrador ou o Parceiro autor da publicação
      allow update: if true || (
        isAdmin() ||
        (isPartner() && (
          resource.data.publishedBy == request.auth.uid ||
          request.resource.data.publishedBy == request.auth.uid
        ))
      );

      // Eliminação de anúncio: Administrador ou Parceiro proprietário
      allow delete: if true || (
        isAdmin() ||
        (isPartner() && resource.data.publishedBy == request.auth.uid)
      );

      // Subcoleção: Avaliações, Comentários e Opiniões de Clientes
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if true || isAdmin();
      }

      // Subcoleção: Pedidos Diretos de Informação e Agendamentos no Imóvel
      match /inquiries/{inquiryId} {
        allow read: if true || isAdmin();
        allow create: if true;
        allow update, delete: if true || isAdmin();
      }

      // Subcoleção: Histórico de Alterações de Preço, Estado e Métricas do Lote/Imóvel
      match /history/{historyId} {
        allow read: if true;
        allow write: if true || isAdmin() || isPartner();
      }
    }

    // 3. Categorias de Imóveis (Apartamento, Vivenda, Lotes/Terrenos, Comercial, Armazéns, etc.)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true || isAdmin();
    }

    // 4. Províncias e Municípios de Angola (Luanda, Malanje, Benguela, Huíla, etc.)
    match /locations/{locationId} {
      allow read: if true;
      allow write: if true || isAdmin();
    }

    // 5. Configurações Globais do Portal (Contactos, WhatsApp, Telefones, Letreiro, Banners, Missão)
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if true || isAdmin();
    }

    // 6. Contas e Perfis de Utilizadores / Clientes
    match /users/{userId} {
      allow read: if true || isOwner(userId) || isAdmin();
      allow write: if true || isOwner(userId) || isAdmin();

      // Registo de atividades e histórico de navegação do cliente
      match /activities/{activityId} {
        allow read, write: if true || isOwner(userId) || isAdmin();
      }
    }

    // 7. Parceiros B2B (Imobiliárias Associadas, Construtoras e Corretores Independentes)
    match /partners/{partnerId} {
      // Leitura pública de parceiros ativos no catálogo
      allow read: if true;
      // Registo de novo parceiro pelo próprio ou admin
      allow create: if true || isAuthenticated();
      // Atualização de dados da empresa pelo parceiro titular ou admin
      allow update: if true || isOwner(partnerId) || isAdmin();
      // Remoção restrita ao administrador
      allow delete: if true || isAdmin();

      // Documentos de validação de parceiro (Alvará, NIF, Licenças)
      match /documents/{docId} {
        allow read, write: if true || isOwner(partnerId) || isAdmin();
      }

      // Imóveis vinculados à carteira do parceiro
      match /listings/{listingId} {
        allow read: if true;
        allow write: if true || isOwner(partnerId) || isAdmin();
      }
    }

    // 8. Atendimento e Chat em Tempo Real entre Visitantes e a Agência
    match /conversations/{conversationId} {
      allow read, write: if true;

      // Mensagens da conversa em tempo real
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 9. Imóveis e Lotes Favoritos dos Utilizadores
    match /favorites/{favoriteId} {
      allow read, write: if true;
    }

    // 10. Alertas Inteligentes de Pesquisa Personalizada (Filtros de Província, Preço, Tipologia)
    match /alerts/{alertId} {
      allow read, write: if true;
    }

    // 11. Notificações do Sistema e Alertas em Tempo Real
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 12. Coleção de Administradores do Portal
    match /admins/{adminId} {
      allow read: if true || isAdmin();
      allow write: if true || isAdmin();
    }

    // 13. Leads Comerciais e Agendamentos de Visitas Presenciais aos Imóveis/Lotes
    match /leads/{leadId} {
      allow read: if true || isAdmin();
      allow create: if true;
      allow update, delete: if true || isAdmin();
    }

    // 14. Propostas de Compra, Arrendamento e Negociação de Preços
    match /proposals/{proposalId} {
      allow read: if true || isAdmin();
      allow create: if true;
      allow update, delete: if true || isAdmin();
    }

    // 15. Contratos de Reserva, Promessa de Compra e Venda e Documentos Notariais
    match /contracts/{contractId} {
      allow read, write: if true || isAdmin();
    }

    // 16. Transações Financeiras e Recibos de Sinais e Cauções
    match /transactions/{transactionId} {
      allow read, write: if true || isAdmin();
    }

    // 17. Depoimentos Públicos e Casos de Sucesso de Clientes
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if true || isAdmin();
    }

    // 18. Campanhas, Destaques Visuais e Banners Promocionais
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true || isAdmin();
    }

    // 19. Subscrições da Newsletter e Oportunidades por Email
    match /newsletter/{subscriberId} {
      allow read: if true || isAdmin();
      allow create: if true;
      allow update, delete: if true || isAdmin();
    }

    // 20. Métricas Analíticas, Visualizações de Imóveis e Tendências de Pesquisa
    match /analytics/{docId} {
      allow read, write: if true;
    }

    // 21. Registos de Auditoria e Logs de Segurança
    match /audit_logs/{logId} {
      allow read, write: if true || isAdmin();
    }

    // 22. Configurações Técnicas e Parâmetros de Integração
    match /system_config/{configId} {
      allow read, write: if true || isAdmin();
    }

    // =========================================================================
    // SALVAGUARDA GLOBAL
    // Garante que qualquer funcionalidade futura ou login via Master Key
    // (sessão administrativa sem UID no Firebase Auth) continue a funcionar
    // perfeitamente sem bloqueios de permissão.
    // =========================================================================
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
